      "parameter": { "type": "number", "default": "1" },
      "examples": [
        {
          "arguments": ["1"],
          "en": "Default horizontal offset",
          "pt-BR": "Deslocamento horizontal padrão"
        }
      ]
    },
    "cl_hud_telemetry_frametime_show": {
      "sourceId": "arminc-console-2025",
      "parameter": {
        "type": "integer",
        "default": "1",
        "values": [
          { "value": "0", "en": "Never", "pt-BR": "Nunca" },
          {
            "value": "1",
            "en": "Only when frame time is poor",
            "pt-BR": "Somente quando o tempo de quadro estiver ruim"
          },
          { "value": "2", "en": "Always", "pt-BR": "Sempre" }
