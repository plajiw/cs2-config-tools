{
  "scopeName": "source.cs2cfg",
  "patterns": [
    { "name": "comment.line.double-slash.cs2cfg", "begin": "//", "end": "$" },
    { "name": "string.quoted.double.cs2cfg", "begin": "\"", "end": "\"" },
    {
      "name": "constant.numeric.cs2cfg",
      "match": "(?<![\\w])[-+]?(?:[0-9]+(?:\\.[0-9]+)?|\\.[0-9]+)(?![\\w])"
    },
    { "name": "keyword.control.cs2cfg", "match": "\\b(?:bind|alias|exec|toggle|buy|echo)\\b" },
    {
      "name": "entity.name.function.cs2cfg",
      "match": "(?:^|;)\\s*([+\\-]?[a-zA-Z_][a-zA-Z0-9_]*)",
      "captures": { "1": { "name": "entity.name.function.cs2cfg" } }
    }
  ]
}
