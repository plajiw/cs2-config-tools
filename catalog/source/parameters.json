          { "value": "4", "en": "Blue", "pt-BR": "Azul" },
          { "value": "5", "en": "Purple", "pt-BR": "Roxo" },
          { "value": "6", "en": "Red", "pt-BR": "Vermelho" },
          { "value": "7", "en": "Orange", "pt-BR": "Laranja" },
          { "value": "8", "en": "Yellow", "pt-BR": "Amarelo" },
          { "value": "9", "en": "Green", "pt-BR": "Verde" },
          { "value": "10", "en": "Aqua", "pt-BR": "Ciano" },
          { "value": "11", "en": "Pink", "pt-BR": "Rosa" },
          {
            "value": "12",
            "en": "Teammate color",
            "pt-BR": "Cor de identificação do jogador na equipe"
